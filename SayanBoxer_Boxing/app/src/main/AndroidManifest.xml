<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:allowBackup="true" android:label="Sayan Boxer" android:icon="@drawable/ic_glove" android:theme="@style/Theme.SayanBoxer" android:supportsRtl="true">
        <activity android:name=".SessionActivity" android:exported="false" />
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <service android:name=".WorkoutService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
